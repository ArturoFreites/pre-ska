---
const siteUrl = "https://ska.ar";
const brandName = "SKA";
const pageTitle = "404 | SKA";
const pageDescription = "Esta página no existe.";
---

<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<style is:inline>
			html,
			body {
				background: #000000;
			}
		</style>
		<link rel="icon" type="image/png" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#000000" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
		<meta name="color-scheme" content="dark" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="author" content="SKA" />
		<meta name="application-name" content="SKA" />
		<meta name="description" content={pageDescription} />
		<title>{pageTitle}</title>
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={brandName} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:url" content={`${siteUrl}/404`} />
		<meta property="og:locale" content="es_AR" />
		<link
			rel="preload"
			href="/fonts/arial-black-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/archivo-black-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		<div class="bg-media" aria-hidden="true">
			<video
				id="bg-video"
				class="bg-media__video"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster="/fondo.jpg"
				data-src-mobile="/fondo-mobile.mp4"
				data-src-desktop="/fondo-desktop.mp4"
				data-poster-mobile="/fondo.jpg"
				data-poster-desktop="/fondo-desktop.jpg"
			></video>
		</div>

		<main class="stage" id="not-found">
			<div class="content">
				<header class="brand">
					<a
						href="/"
						class="logo"
						aria-label="SKA, ir al inicio"
					></a>
				</header>

				<section class="message" aria-labelledby="nf-code">
					<p class="code" id="nf-code">404</p>
					<h1 class="copy">esta página no existe</h1>
				</section>

				<footer class="outro">
					<a class="home-link" href="/">inicio</a>
				</footer>
			</div>
		</main>

		<script>
			const bgVideo = document.getElementById("bg-video") as HTMLVideoElement | null;
			const bgMedia = document.querySelector<HTMLElement>(".bg-media");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const desktopBg = window.matchMedia("(min-width: 768px)");

			const syncBgVideo = () => {
				if (!bgVideo) return;

				const desktop = desktopBg.matches;
				const nextSrc = desktop
					? (bgVideo.dataset.srcDesktop ?? "/fondo-desktop.mp4")
					: (bgVideo.dataset.srcMobile ?? "/fondo-mobile.mp4");
				const nextPoster = desktop
					? (bgVideo.dataset.posterDesktop ?? "/fondo-desktop.jpg")
					: (bgVideo.dataset.posterMobile ?? "/fondo.jpg");

				if (bgMedia) {
					bgMedia.style.backgroundImage = `url("${nextPoster}")`;
				}
				bgVideo.poster = nextPoster;

				if (reduceMotion) {
					bgVideo.pause();
					bgVideo.removeAttribute("autoplay");
					bgVideo.removeAttribute("src");
					bgVideo.load();
					return;
				}

				if (bgVideo.dataset.activeSrc !== nextSrc) {
					bgVideo.dataset.activeSrc = nextSrc;
					bgVideo.src = nextSrc;
					bgVideo.load();
				}

				void bgVideo.play().catch(() => {
					/* Autoplay bloqueado: queda el poster */
				});
			};

			syncBgVideo();
			desktopBg.addEventListener("change", syncBgVideo);
		</script>
	</body>
</html>

<style is:global>
	@font-face {
		font-family: "Arial Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src:
			url("/fonts/arial-black-regular.woff2") format("woff2"),
			local("Arial Black"),
			local("Arial-Black");
	}

	@font-face {
		font-family: "Archivo Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src: url("/fonts/archivo-black-latin-ext.woff2") format("woff2");
		unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
	}

	@font-face {
		font-family: "Archivo Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src: url("/fonts/archivo-black-latin.woff2") format("woff2");
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:root {
		--ink: #ffffff;
		--chrome: #000000;
		--veil: rgba(0, 0, 0, 0.18);
		--font-black: "Archivo Black", sans-serif;
		--font-arial: Arial, Helvetica, sans-serif;
		--font-date: "Arial Black", sans-serif;
	}

	html,
	body {
		width: 100%;
		max-width: 100%;
		min-height: 100%;
		height: 100%;
		overflow: hidden;
		background: var(--chrome);
	}

	body {
		font-family: var(--font-arial);
		color: var(--ink);
		background: var(--chrome);
		-webkit-font-smoothing: auto;
		text-rendering: optimizeLegibility;
		overscroll-behavior: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}
</style>

<style>
	.bg-media {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		background: var(--chrome) url("/fondo.jpg") center / cover no-repeat;
	}

	.bg-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.stage {
		position: fixed;
		inset: 0;
		isolation: isolate;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		height: 100dvh;
		overflow: hidden;
		background: transparent;
	}

	.stage::before {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: var(--veil);
	}

	.stage::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0.22;
		mix-blend-mode: overlay;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
		background-size: 180px 180px;
	}

	.content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: 34rem;
		height: 100%;
		min-height: 100%;
		padding:
			max(clamp(3.25rem, 11vh, 6.5rem), env(safe-area-inset-top, 0px))
			max(1.25rem, env(safe-area-inset-right, 0px))
			max(clamp(3rem, 10vh, 6rem), env(safe-area-inset-bottom, 0px))
			max(1.25rem, env(safe-area-inset-left, 0px));
		text-align: center;
	}

	.brand {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.logo {
		display: block;
		width: clamp(6.5rem, 28vw, 8.5rem);
		aspect-ratio: 220 / 90;
		background-color: #fff;
		-webkit-mask-image: url("/logo.png");
		mask-image: url("/logo.png");
		-webkit-mask-mode: luminance;
		mask-mode: luminance;
		-webkit-mask-size: contain;
		mask-size: contain;
		-webkit-mask-repeat: no-repeat;
		mask-repeat: no-repeat;
		-webkit-mask-position: center;
		mask-position: center;
		user-select: none;
		transition: opacity 0.2s ease;
	}

	.logo:hover {
		opacity: 0.75;
	}

	.logo:focus {
		outline: none;
	}

	.logo:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.45);
		outline-offset: 4px;
	}

	.message {
		display: flex;
		flex: 0 0 auto;
		flex-direction: column;
		align-items: center;
		gap: 0.55rem;
		animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
	}

	.code {
		font-family: var(--font-date);
		font-weight: 400;
		font-style: normal;
		font-synthesis: none;
		font-size: clamp(5.5rem, 28vw, 11rem);
		line-height: 1;
		letter-spacing: -0.085em;
	}

	.copy {
		font-family: var(--font-black);
		font-weight: 400;
		font-size: clamp(1.15rem, 4.6vw, 1.55rem);
		line-height: 1.05;
		letter-spacing: -0.04em;
	}

	.outro {
		flex-shrink: 0;
		animation: rise 1.05s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
	}

	.home-link {
		font-family: var(--font-black);
		font-weight: 400;
		font-size: clamp(1.35rem, 5.2vw, 1.75rem);
		line-height: 1;
		letter-spacing: -0.06em;
		transition: opacity 0.2s ease;
	}

	.home-link:hover {
		opacity: 0.75;
	}

	.home-link:focus {
		outline: none;
	}

	.home-link:focus-visible {
		outline: 2px solid rgba(255, 255, 255, 0.45);
		outline-offset: 4px;
	}

	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(14px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	@media (min-width: 768px) {
		.bg-media {
			background-image: url("/fondo-desktop.jpg");
		}

		.content {
			max-width: 40rem;
			padding-block:
				max(clamp(3.5rem, 10vh, 6rem), env(safe-area-inset-top, 0px))
				max(clamp(3rem, 9vh, 5.5rem), env(safe-area-inset-bottom, 0px));
		}

		.logo {
			width: 6.75rem;
		}

		.code {
			font-size: 9rem;
		}

		.copy {
			font-size: 1.45rem;
		}

		.home-link {
			font-size: 1.55rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.bg-media__video {
			display: none;
		}

		.brand,
		.message,
		.outro {
			animation: none;
		}
	}
</style>
