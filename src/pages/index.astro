---
import DinoOnSet from "../components/easter-eggs/DinoOnSet.astro";

const targetDate = "2026-09-21T00:00:00-03:00";
const siteUrl = "https://ska.ar";
const brandName = "SKA";
const pageTitle = "SKA | Productora audiovisual";
const pageDescription =
	"SKA es una productora audiovisual. Hacemos que suceda. Seguinos en Instagram @ska.prd y @ska.raw. Lanzamiento 21/09.";
const ogTitle = "ska.prd — hacemos que suceda";
const ogDescription = "Productora audiovisual. Hacemos que suceda. 21/09.";
const ogImage = `${siteUrl}/og-image.jpg`;
const igPrd = "https://www.instagram.com/ska.prd/";
const igRaw = "https://www.instagram.com/ska.raw/";

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${siteUrl}/#website`,
			url: siteUrl,
			name: brandName,
			alternateName: ["ska.prd", "SKA Productora"],
			description: pageDescription,
			inLanguage: "es-AR",
			publisher: { "@id": `${siteUrl}/#organization` },
		},
		{
			"@type": "Organization",
			"@id": `${siteUrl}/#organization`,
			name: brandName,
			alternateName: ["ska.prd", "SKA Productora audiovisual"],
			url: siteUrl,
			logo: {
				"@type": "ImageObject",
				url: `${siteUrl}/favicon.png`,
				width: 512,
				height: 512,
			},
			image: ogImage,
			description:
				"Productora audiovisual. Contenido, producción y postproducción. Hacemos que suceda.",
			sameAs: [igPrd, igRaw],
			areaServed: {
				"@type": "Country",
				name: "Argentina",
			},
		},
		{
			"@type": "WebPage",
			"@id": `${siteUrl}/#webpage`,
			url: siteUrl,
			name: pageTitle,
			description: pageDescription,
			isPartOf: { "@id": `${siteUrl}/#website` },
			about: { "@id": `${siteUrl}/#organization` },
			primaryImageOfPage: {
				"@type": "ImageObject",
				url: ogImage,
				width: 1200,
				height: 630,
			},
			inLanguage: "es-AR",
		},
		{
			"@type": "Event",
			"@id": `${siteUrl}/#launch`,
			name: "Lanzamiento SKA",
			description: "Lanzamiento de SKA, productora audiovisual. Hacemos que suceda.",
			startDate: "2026-09-21",
			eventAttendanceMode: "https://schema.org/OnlineEventAttendanceMode",
			eventStatus: "https://schema.org/EventScheduled",
			url: siteUrl,
			image: ogImage,
			organizer: { "@id": `${siteUrl}/#organization` },
			location: {
				"@type": "VirtualLocation",
				url: siteUrl,
			},
		},
	],
};
---

<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/png" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#7a0f12" />
		<meta name="color-scheme" content="dark" />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="googlebot" content="index, follow" />
		<meta name="author" content="SKA" />
		<meta name="application-name" content="SKA" />
		<meta name="description" content={pageDescription} />
		<meta
			name="keywords"
			content="SKA, ska.prd, ska.raw, productora audiovisual, producción audiovisual, video, cine, contenido, Argentina"
		/>
		<title>{pageTitle}</title>
		<link rel="canonical" href={siteUrl} />
		<link rel="alternate" hreflang="es-AR" href={siteUrl} />
		<link rel="alternate" hreflang="x-default" href={siteUrl} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:site_name" content={brandName} />
		<meta property="og:title" content={ogTitle} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:alt" content="SKA — productora audiovisual. Hacemos que suceda." />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:locale" content="es_AR" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={ogTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content="SKA — productora audiovisual. Hacemos que suceda." />
		<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<link
			rel="preload"
			href="/fonts/arial-black-regular.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/archivo-black-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/montserrat-extrabold-latin.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
	</head>
	<body>
		{/* Texto indexable siempre en el HTML (fuera del splash / visibility:hidden) */}
		<section class="seo-copy" aria-label="Sobre SKA">
			<h1>SKA — Productora audiovisual</h1>
			<p>
				SKA es una productora audiovisual. Creamos contenido, producción y postproducción.
				Hacemos que suceda.
			</p>
			<p>Lanzamiento: 21 de septiembre de 2026.</p>
			<p>
				Instagram:
				<a href={igPrd} rel="noopener noreferrer">@ska.prd</a>
				{" · "}
				<a href={igRaw} rel="noopener noreferrer">@ska.raw</a>
			</p>
		</section>

		<div class="bg-media" aria-hidden="true">
			<video
				id="bg-video"
				class="bg-media__video"
				autoplay
				muted
				loop
				playsinline
				preload="metadata"
				poster="/fondo.jpg"
				data-src-mobile="/fondo-mobile.mp4"
				data-src-desktop="/fondo-desktop.mp4"
				data-poster-mobile="/fondo.jpg"
				data-poster-desktop="/fondo-desktop.jpg"
			></video>
		</div>

		<div class="splash" id="splash" aria-hidden="true">
			<span class="splash-logo logo" role="img" aria-label="SKA"></span>
		</div>

		<main class="stage is-waiting" id="home">
			<div class="content">
				<header class="brand">
					<button
						type="button"
						class="logo logo--trigger"
						data-dino-trigger
						aria-label="SKA, productora audiovisual"
					></button>
				</header>

				<section class="launch" aria-label="Lanzamiento SKA 21 de septiembre">
					<a
						class="handle"
						href={igPrd}
						target="_blank"
						rel="noopener noreferrer me"
					>
						@ska.prd
					</a>
					<p class="date" aria-label="21 de septiembre">
						<span aria-hidden="true">21</span><span class="slash" aria-hidden="true"></span><span aria-hidden="true">09</span>
					</p>
					<div class="countdown" data-target={targetDate} aria-live="polite">
						<div class="unit">
							<span class="value" data-unit="days">00</span>
							<span class="label">días</span>
						</div>
						<span class="sep" aria-hidden="true">:</span>
						<div class="unit">
							<span class="value" data-unit="hours">00</span>
							<span class="label">horas</span>
						</div>
						<span class="sep" aria-hidden="true">:</span>
						<div class="unit">
							<span class="value" data-unit="mins">00</span>
							<span class="label">mins</span>
						</div>
						<span class="sep" aria-hidden="true">:</span>
						<div class="unit">
							<span class="value" data-unit="segs">00</span>
							<span class="label">segs</span>
						</div>
					</div>
				</section>

				<footer class="outro">
					<p class="tagline">
						<span class="tagline__line">hacemos que</span>
						<span class="tagline__line">suceda<span class="accent" aria-hidden="true"></span></span>
					</p>
					<button
						type="button"
						class="play-egg"
						data-dino-open
						aria-label="Jugar Dino on Set"
					>
						<span class="play-egg__icon" aria-hidden="true"></span>
					</button>
				</footer>
			</div>
		</main>

		<DinoOnSet />

		<script>
			import { mountDinoGame, bindDinoTriggers } from "../scripts/dino-game";

			const splash = document.getElementById("splash");
			const home = document.getElementById("home");
			const bgVideo = document.getElementById("bg-video") as HTMLVideoElement | null;
			const bgMedia = document.querySelector<HTMLElement>(".bg-media");
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
			const desktopBg = window.matchMedia("(min-width: 768px)");

			const syncBgVideo = () => {
				if (!bgVideo) return;

				const desktop = desktopBg.matches;
				const nextSrc = desktop
					? (bgVideo.dataset.srcDesktop ?? "/fondo-desktop.mp4")
					: (bgVideo.dataset.srcMobile ?? "/fondo-mobile.mp4");
				const nextPoster = desktop
					? (bgVideo.dataset.posterDesktop ?? "/fondo-desktop.jpg")
					: (bgVideo.dataset.posterMobile ?? "/fondo.jpg");

				if (bgMedia) {
					bgMedia.style.backgroundImage = `url("${nextPoster}")`;
				}
				bgVideo.poster = nextPoster;

				if (reduceMotion) {
					bgVideo.pause();
					bgVideo.removeAttribute("autoplay");
					bgVideo.removeAttribute("src");
					bgVideo.load();
					return;
				}

				if (bgVideo.dataset.activeSrc !== nextSrc) {
					bgVideo.dataset.activeSrc = nextSrc;
					bgVideo.src = nextSrc;
					bgVideo.load();
				}

				void bgVideo.play().catch(() => {
					/* Autoplay bloqueado: queda el poster */
				});
			};

			syncBgVideo();
			desktopBg.addEventListener("change", syncBgVideo);

			const revealHome = () => {
				home?.classList.remove("is-waiting");
				home?.classList.add("is-ready");
				splash?.classList.add("is-done");
				splash?.addEventListener(
					"transitionend",
					() => splash.remove(),
					{ once: true },
				);
				if (reduceMotion) splash?.remove();
			};

			if (reduceMotion) {
				revealHome();
			} else {
				// appear ~1s + pulse ~2.2s → then fade
				window.setTimeout(revealHome, 3400);
			}

			const root = document.querySelector<HTMLElement>(".countdown");
			if (root) {
				const target = new Date(root.dataset.target ?? "").getTime();
				const daysEl = root.querySelector('[data-unit="days"]');
				const hoursEl = root.querySelector('[data-unit="hours"]');
				const minsEl = root.querySelector('[data-unit="mins"]');
				const segsEl = root.querySelector('[data-unit="segs"]');

				const pad = (n: number) => String(Math.max(0, n)).padStart(2, "0");

				const tick = () => {
					const diff = Math.max(0, target - Date.now());
					const totalSecs = Math.floor(diff / 1000);
					const days = Math.floor(totalSecs / 86400);
					const hours = Math.floor((totalSecs % 86400) / 3600);
					const mins = Math.floor((totalSecs % 3600) / 60);
					const segs = totalSecs % 60;

					if (daysEl) daysEl.textContent = pad(days);
					if (hoursEl) hoursEl.textContent = pad(hours);
					if (minsEl) minsEl.textContent = pad(mins);
					if (segsEl) segsEl.textContent = pad(segs);
				};

				tick();
				setInterval(tick, 1000);
			}

			const dinoRoot = document.getElementById("dino-on-set");
			if (dinoRoot) {
				const api = mountDinoGame(dinoRoot);
				const triggers = [
					...document.querySelectorAll<HTMLElement>("[data-dino-trigger]"),
				];
				bindDinoTriggers(api, triggers);
				for (const btn of document.querySelectorAll<HTMLElement>("[data-dino-open]")) {
					btn.addEventListener("click", () => api.open());
				}
			}
		</script>
	</body>
</html>

<style is:global>
	/* Arial Black Regular self-hosted — fuerza el mismo corte en Safari/iOS */
	@font-face {
		font-family: "Arial Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src:
			url("/fonts/arial-black-regular.woff2") format("woff2"),
			local("Arial Black"),
			local("Arial-Black");
	}

	/* Archivo Black self-hosted para handle / slogan */
	@font-face {
		font-family: "Archivo Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src: url("/fonts/archivo-black-latin-ext.woff2") format("woff2");
		unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
	}

	@font-face {
		font-family: "Archivo Black";
		font-style: normal;
		font-weight: 400;
		font-display: block;
		src: url("/fonts/archivo-black-latin.woff2") format("woff2");
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	/* Nombre distinto al sistema/Adobe para forzar el archivo self-hosted (mismo corte ExtraBold) */
	@font-face {
		font-family: "Montserrat ExtraBold";
		font-style: normal;
		font-weight: 800;
		font-display: block;
		src: url("/fonts/montserrat-extrabold-latin-ext.woff2") format("woff2");
		unicode-range: U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C0, U+2113, U+2C60-2C7F, U+A720-A7FF;
	}

	@font-face {
		font-family: "Montserrat ExtraBold";
		font-style: normal;
		font-weight: 800;
		font-display: block;
		src: url("/fonts/montserrat-extrabold-latin.woff2") format("woff2");
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
		margin: 0;
		padding: 0;
	}

	:root {
		--ink: #ffffff;
		--accent: #e95514;
		/* Self-hosted Archivo Black para handle / slogan */
		--font-black: "Archivo Black", sans-serif;
		--font-arial: Arial, Helvetica, sans-serif;
		/* Self-hosted Arial Black Regular para la fecha */
		--font-date: "Arial Black", sans-serif;
		/* Self-hosted — mismo nombre que en Photoshop */
		--font-counter: "Montserrat ExtraBold", sans-serif;
	}

	html,
	body {
		width: 100%;
		max-width: 100%;
		min-height: 100%;
		height: 100%;
		overflow: hidden;
	}

	body {
		font-family: var(--font-arial);
		color: var(--ink);
		background: #7a0f12;
		/* Safari: antialiased adelgaza tipografía display en blanco */
		-webkit-font-smoothing: auto;
		text-rendering: optimizeLegibility;
		overscroll-behavior: none;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	/* Contenido para crawlers / lectores de pantalla; no altera el layout visual */
	.seo-copy {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}
</style>

<style>
	.bg-media {
		position: fixed;
		inset: 0;
		z-index: 0;
		pointer-events: none;
		overflow: hidden;
		background: #2a2a2a url("/fondo.jpg") center / cover no-repeat;
		filter: grayscale(1) brightness(0.38);
	}

	.bg-media__video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
	}

	.splash {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		height: 100dvh;
		z-index: 40;
		display: grid;
		place-items: center;
		overflow: hidden;
		background: transparent;
		transition: opacity 0.75s ease;
	}

	.splash::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0.22;
		mix-blend-mode: overlay;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
		background-size: 180px 180px;
	}

	.splash.is-done {
		opacity: 0;
		pointer-events: none;
	}

	.splash-logo {
		position: relative;
		z-index: 1;
		width: min(92vw, 50rem);
		opacity: 0;
		transform: scale(0.88);
		animation: splash-sequence 3.4s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.stage {
		position: fixed;
		inset: 0;
		isolation: isolate;
		display: grid;
		place-items: center;
		width: 100%;
		height: 100%;
		height: 100dvh;
		overflow: hidden;
		background: transparent;
	}

	.stage::after {
		content: "";
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		opacity: 0.22;
		mix-blend-mode: overlay;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
		background-size: 180px 180px;
	}

	.stage.is-waiting .content {
		visibility: hidden;
	}

	.content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: space-between;
		width: 100%;
		max-width: 34rem;
		height: 100%;
		min-height: 100%;
		/* Más padding en bordes → ~50% menos aire entre logo / fecha / slogan */
		padding:
			max(clamp(5.5rem, 19vh, 10rem), env(safe-area-inset-top, 0px))
			max(1.25rem, env(safe-area-inset-right, 0px))
			max(clamp(5rem, 17vh, 9rem), env(safe-area-inset-bottom, 0px))
			max(1.25rem, env(safe-area-inset-left, 0px));
		text-align: center;
	}

	.brand {
		flex-shrink: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.stage.is-ready .brand {
		animation: rise 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
	}

	.launch {
		display: flex;
		flex: 0 0 auto;
		flex-direction: column;
		align-items: center;
		/* Cluster handle + fecha + countdown bien cerrado */
		gap: 0.15rem;
	}

	.stage.is-ready .launch {
		animation: rise 1s cubic-bezier(0.22, 1, 0.36, 1) 0.12s both;
	}

	.handle {
		font-family: var(--font-black);
		font-weight: 400;
		/* Ligeramente menor que el tagline; ancho ~ del bloque numérico */
		font-size: clamp(1.55rem, 6vw, 2.2rem);
		line-height: 0.85;
		letter-spacing: -0.095em;
		transition: opacity 0.2s ease;
	}

	.handle:hover {
		opacity: 0.75;
	}

	.date {
		display: inline-flex;
		align-items: baseline;
		justify-content: center;
		font-family: var(--font-date);
		font-weight: 400; /* Arial Black Regular */
		font-style: normal;
		font-synthesis: none;
		/* Escala al ancho útil del viewport para no desbordar en móvil */
		font-size: clamp(5.5rem, 30vw, 12.5rem);
		/* line-height < 1 desalineaba la barra respecto al ink de los dígitos */
		line-height: 1;
		white-space: nowrap;
		max-width: 100%;
	}

	.date > span:not(.slash) {
		/* Tracking cerrado pero sin fusionar tinta (0/9 apenas se rozan) */
		letter-spacing: -0.085em;
	}

	.date .slash {
		/* Altura = cap de la fuente → mismo tope/base que los dígitos lining */
		flex-shrink: 0;
		width: 0.125em;
		height: 1cap;
		/* Más cerca del "1" (margen izquierdo ~1/8 del original) */
		margin-inline: 0.019em 0.133em;
